# Reef benchmark profile - CLASS C: ingestion at 10k/s (venue core, no Calcify)
#
# Machine-readable: KEY=value lines; each key is preceded by `# why:`, `# default:`, `# enforce:`
# and (where relevant) `# forced-by:` / `# defaulted-by:` comment lines. Parsed by
# scripts/bench/lib/profile.mjs. Shell-sourceable to APPLY it:
#     set -a; . scripts/bench/profiles/class-c-ingestion-10k.env; set +a
# Values containing spaces or pipes are double-quoted. REEF_TOPIC_* keys are broker topic configs (checked with rpk
# when a broker is up), harmless when exported. Compose defaults and service defaults are NOT changed by this file; the profile sets the right
# values explicitly.
#
# enforce: required = must resolve to this value explicitly (compose default is wrong and no launcher sets it)
#          if-set   = unset is fine ONLY because a launcher forces/defaults it (see forced-by/defaulted-by),
#                     or because the default is already right; a different explicit value is a FAIL
#          advisory = a different value only WARNS
# forced-by:    launcher ids (materializer = make dev-stress-venue-event-materializer,
#               nodb = make dev-stress-stream-direct-nodb) whose script overwrites the key (setValue)
# defaulted-by: launcher ids whose script sets it only when empty (setDefault); an explicit value wins
#
# @profile: class-c-ingestion-10k
# @class: c
# @purpose: 10,000 accepted commands/s: HTTP 202 only after durable Redpanda append -> Go engine direct-consume -> canonical events (+ materializer to Postgres). The OFFICIAL gate is the DigitalOcean c-16 gate; a laptop run is diagnostic only and must never be quoted as a claim.
# @command: make bench-preflight CLASS=c && set -a && . scripts/bench/profiles/class-c-ingestion-10k.env && set +a && make dev-stress-venue-event-materializer     (local diagnostic, durable-canonical)
# @command: set -a && . scripts/bench/profiles/class-c-ingestion-10k.env && set +a && make dev-stress-stream-direct-nodb     (local ingress-only ceiling, no materializer)
# @command: make do-materializer-10k-gate   (OFFICIAL: plan only; real run = REEF_DO_CONFIRM_DESTROYABLE=1 make do-materializer-10k-gate ARGS=run-destroy; PAID, owner approval + cost first)
# @compose: compose.base.yml + compose.local.yml (default REEF_COMPOSE_FILES); compose profiles redpanda, venue-event-materializer, venue-event-materializer-scaled (added by the materializer script). Never compose.arena.yml.
# @pass: official gate (scripts/dev/do-gate.mjs materializer-10k): attempted rps >= 9900, accepted rps >= 9900, p95 <= 100 ms, p99 <= 200 ms, >= 16 active direct-stream partitions, max partition skew <= 4, success rate 100%, accepted/direct-acked/materialized gaps 0, DB diagnostics present. Local script: completion gaps 0, success >= 95%.
# @host: official = DigitalOcean c-16 (16 vCPU Xeon 8168); local = Docker VM >= 10 CPU / 15.6 GiB, QUIET host, no other Reef stack. Laptop overstates target hardware 2-2.7x.
# @claimable: only the DO c-16 gate (do-gate.mjs); local runs are diagnostic
#
# CONFLICTS (recorded; value in this file = what the official gate / materializer script uses):
# - Load workers: official gate 1024 (do-gate.mjs commonDefaults REEF_DO_STRESS_WORKERS), local
#   materializer script default 384, nodb stress profile 256. 1024 chosen (gate). 384 does not
#   reproduce the 10k baseline (infra/do-benchmark/README.md).
# - Publish pipeline queue capacity: materializer script + Calcify bootstrap 8192, stream-direct-nodb
#   profile 1024, compose default 4096. 8192 chosen (materializer script + gate-equivalent path).
# - Terminal order retention: materializer script 250000 per book (64 books = 16M records, size memory),
#   Calcify soak 3906. 250000 chosen for class C (see class B profile for 3906).
# - Redpanda version: compose.local.yml is the single source of truth (v26.2.4); droplet-chain-run.sh now reads its
#   engine-drain image from there. Older ledger rows used v26.2.3. Not enforced, recorded in the stamp.
# - Redpanda sizing is only the compose default (--smp 2 --memory 2G, REEF_REDPANDA_SMP/MEMORY); no
#   benchmark script pins it. Recorded in the stamp, not enforced.
# - Compression: stream-direct-nodb redpanda branch sets MATCHING_ENGINE_KAFKA_COMPRESSION_TYPE=none; the
#   materializer script does not set it (compose falls back to STREAM_ACK_KAFKA_COMPRESSION_TYPE=lz4).
#   Advisory only; the 4 MiB message cap below makes both codecs safe.
# - Dedicated-host source shipping: do-benchmark-host.sh sync and droplet-chain-run.sh both refuse a dirty
#   tracked tree and ship `git archive HEAD` (untracked files are never shipped). Preflight --target droplet requires a clean tracked tree.
# - Scheduled materializer-10k-gate.yml cron runs `plan` only; it never exercises the real gate.

# why: Admin auth on makes platform-api demand an admin Postgres URL at boot, which the noop-persistence launchers do not provide, and a developer .env (compose auto-loads it) that sets it true crashes the run. Both launchers now overwrite it.
# default: false (compose.base.yml:38), but .env can override it
# enforce: required
# forced-by: materializer,nodb
PLATFORM_ADMIN_AUTH_ENABLED=false

# why: Admin bypass changes the auth path under test; must not come from a developer .env.
# default: false (compose.base.yml:40)
# enforce: required
# forced-by: materializer,nodb
LOCAL_DEV_ADMIN_AUTH_BYPASS=false

# why: A risk check mode other than allow-all adds per-order checks to the hot path.
# default: allow-all (compose.base.yml:25)
# enforce: required
# forced-by: materializer,nodb
EXTERNAL_API_ACCOUNT_RISK_CHECK_MODE=allow-all

# why: A circuit breaker mode other than allow-all can reject benchmark commands.
# default: allow-all (compose.base.yml:30)
# enforce: required
# forced-by: materializer,nodb
EXTERNAL_API_COMMAND_CIRCUIT_BREAKER_MODE=allow-all

# why: A price collar can reject benchmark orders.
# default: allow-all (compose.base.yml:32)
# enforce: required
# forced-by: materializer,nodb
EXTERNAL_API_INSTRUMENT_PRICE_COLLAR_MODE=allow-all

# why: JDK HttpServer tops out ~6k/s; Netty is the only front door with 10k/s support.
# default: jdk (compose.base.yml:171)
# enforce: if-set
# forced-by: materializer,nodb
PLATFORM_HTTP_SERVER=netty

# why: Entire direct-consume path is Kafka-compatible; jetstream is the NATS legacy path. Both launchers force it (nodb: applyStreamDirectNoDbProfile).
# default: jetstream (compose.base.yml:73)
# enforce: required
# forced-by: materializer,nodb
STREAM_ACK_LOG_PROVIDER=redpanda

# why: Per-order Postgres intake caps ACK at ~6-8k/s (CAL-J10K); in-memory bounded intake is the validated profile.
# default: postgres (compose.base.yml:89)
# enforce: if-set
# forced-by: materializer,nodb
STREAM_ACK_INTAKE_STORE=inmemory

# why: SQL idempotency on the hot path caps throughput the same way.
# default: postgres (compose.base.yml:24)
# enforce: if-set
# forced-by: materializer,nodb
EXTERNAL_API_IDEMPOTENCY_STORE=inmemory

# why: Synchronous DB writes on the submit path.
# default: postgres (compose.base.yml:16)
# enforce: if-set
# forced-by: materializer,nodb
RUNTIME_PERSISTENCE=noop

# why: Command-log writes on the hot path.
# default: disabled (compose.base.yml:54), so this only guards an explicit override
# enforce: if-set
# forced-by: materializer,nodb
EXTERNAL_API_COMMAND_LOG_MODE=disabled

# why: Legacy command capture writes on the hot path.
# default: postgres (compose.base.yml:53)
# enforce: if-set
# forced-by: materializer,nodb
EXTERNAL_API_COMMAND_CAPTURE_MODE=disabled

# why: The benchmark sends repeated rejects; an active abuse breaker would 429 and distort results.
# default: off (compose.base.yml:161); only guards an explicit override
# enforce: if-set
# forced-by: materializer,nodb
EXTERNAL_API_ABUSE_BREAKER_MODE=off

# why: Unbounded in-memory intake/idempotency retention grows heap and OOMs long soaks. stream-profile-guard rejects 0 for soak profiles.
# default: 0 = unlimited (compose.base.yml:90)
# enforce: if-set
# defaulted-by: materializer,nodb
STREAM_ACK_INMEMORY_INTAKE_MAX_ENTRIES=100000

# why: Lock contention in the in-memory intake.
# default: 64 (compose.base.yml:91)
# enforce: if-set
# defaulted-by: materializer,nodb
STREAM_ACK_INMEMORY_INTAKE_SHARDS=256

# why: Without the pipeline every request publishes synchronously, no partition lanes.
# default: false (compose.base.yml:95)
# enforce: if-set
# defaulted-by: materializer,nodb
STREAM_ACK_PUBLISH_PIPELINE_ENABLED=true

# why: Lane queue sizing for the 10k validated path (see CONFLICTS: nodb profile uses 1024).
# default: 4096 (compose.base.yml:96)
# enforce: advisory
# defaulted-by: materializer
STREAM_ACK_PUBLISH_PIPELINE_QUEUE_CAPACITY=8192

# why: Per-lane in-flight publishes.
# default: 256 (compose.base.yml:97)
# enforce: advisory
# defaulted-by: materializer,nodb
STREAM_ACK_PUBLISH_PIPELINE_MAX_IN_FLIGHT_PER_LANE=256

# why: Batching with linger measured WORSE (8,642/s vs 9,995/s unbatched).
# default: 1 (compose.base.yml:98)
# enforce: advisory
# defaulted-by: materializer,nodb
STREAM_ACK_PUBLISH_PIPELINE_BATCH_SIZE=1

# why: See batch size.
# default: 0 (compose.base.yml:99)
# enforce: advisory
# defaulted-by: materializer,nodb
STREAM_ACK_PUBLISH_PIPELINE_BATCH_LINGER_MS=0

# why: 64 partitions overflow the single local Redpanda partition-memory cap (1060 vs 1048); gates need >= 16 active partitions.
# default: 64 (compose.base.yml:88)
# enforce: if-set
# defaulted-by: materializer
STREAM_ACK_PARTITION_COUNT=16

# why: Engine consumes nothing unless direct stream is on.
# default: false (compose.base.yml:235)
# enforce: if-set
# forced-by: materializer,nodb
MATCHING_ENGINE_DIRECT_STREAM_ENABLED=true

# why: Engine consumes only these partitions; must cover all 16.
# default: empty (compose.base.yml:237)
# enforce: if-set
# defaulted-by: materializer
MATCHING_ENGINE_DIRECT_STREAM_PARTITIONS=0..15

# why: Batch 1000 failed a 5-min 10.5k soak (batches over the producer cap, nackedDelta=43276); 500 is clean.
# default: 500 (compose.base.yml:239)
# enforce: if-set
# defaulted-by: materializer,nodb
MATCHING_ENGINE_DIRECT_STREAM_BATCH_SIZE=500

# why: Fetch timeout of the direct consumer.
# default: 200 (compose.base.yml:240)
# enforce: advisory
# defaulted-by: materializer,nodb
MATCHING_ENGINE_DIRECT_STREAM_FETCH_TIMEOUT_MS=100

# why: Poll interval of the direct consumer.
# default: 5 (compose.base.yml:241)
# enforce: advisory
# defaulted-by: materializer,nodb
MATCHING_ENGINE_DIRECT_STREAM_POLL_MS=1

# why: Max un-acked records per lane.
# default: 4000 (compose.base.yml:243)
# enforce: advisory
# defaulted-by: materializer,nodb
MATCHING_ENGINE_DIRECT_STREAM_MAX_ACK_PENDING=16000

# why: Bounds terminal-order memory (matching RSS reached 4.2 GiB with eviction off); stream-profile-guard requires > 0.
# default: 0 = unlimited (compose.base.yml:248)
# enforce: if-set
# defaulted-by: materializer
MATCHING_ENGINE_TERMINAL_ORDER_RETENTION_LIMIT=250000

# why: Event batch above the producer cap makes the engine nack / fatalProcessorError. Default 1 MiB is only safe at batch 500 + lz4. The event TOPIC max.message.bytes must be raised to match (rpk topic alter-config <EVENTS> --set max.message.bytes=4194304); preflight checks the topic when a broker is reachable.
# default: 1048576 (compose.base.yml:257)
# enforce: required
MATCHING_ENGINE_KAFKA_MAX_MESSAGE_BYTES=4194304

# why: Codec differs between launchers (see CONFLICTS); the validated Calcify/nodb profiles use none.
# default: empty -> falls back to STREAM_ACK_KAFKA_COMPRESSION_TYPE (lz4) (compose.base.yml:258)
# enforce: advisory
# defaulted-by: nodb
MATCHING_ENGINE_KAFKA_COMPRESSION_TYPE=none

# why: Generic JetStream workers compete for CPU/Postgres and are not part of the 10k path.
# default: true in the stream-ack stack profile
# enforce: if-set
# forced-by: materializer,nodb
STREAM_ACK_WORKER_ENABLED=false

# why: Gates read /internal/stream-direct/stats; it is only served in enabled mode.
# default: local (compose.base.yml:173)
# enforce: if-set
# forced-by: materializer
PLATFORM_INTERNAL_HTTP_MODE=enabled

# why: Fewer workers make the load generator the limit. Official gate = 1024 (see CONFLICTS).
# default: 384 materializer script / 256 nodb profile / 12 raw stress.mjs
# enforce: advisory
DEV_STRESS_SWEEP_WORKERS=1024

# why: `drop` silently sheds scheduled work so offered load < target.
# default: drop in raw stress.mjs; precise in the launchers
# enforce: advisory
DEV_STRESS_RATE_SCHEDULE=precise

# why: The 10k target rate.
# default: 10000 in the materializer script
# enforce: advisory
DEV_STRESS_RATES=10000

# why: Event/command topics created by the engine/API get broker-default write.caching; durability claims need the ACTUAL topic setting, and the materializer script now pre-creates the command and event topics with it (lib/bench-topics.mjs; stream-direct-nodb still relies on auto-create). Unknown whether the C5 gate ran with it ON, so only a warning (see report).
# default: broker default (cache ON unless cluster write_caching_default=false)
# enforce: advisory
REEF_TOPIC_WRITE_CACHING=false

# why: Event topic cap must match MATCHING_ENGINE_KAFKA_MAX_MESSAGE_BYTES; the engine auto-creates topics with NO config (kafka.go:99); the materializer script now pre-creates the topics with this cap, other launchers need a manual `rpk topic alter-config <EVENTS> --set max.message.bytes=4194304`.
# default: broker default 1048576
# enforce: required
REEF_TOPIC_MAX_MESSAGE_BYTES=4194304
