# Reef benchmark profile - CLASS A: non-Calcify platform guardrails and micro-benchmarks
#
# Machine-readable: KEY=value lines; every key is preceded by `# why:`, `# default:` and
# `# enforce:` comment lines. `@`-lines are header fields. Parsed by scripts/bench/lib/profile.mjs.
# Shell-sourceable (`set -a; . <file>; set +a`) but class A needs nothing sourced: the scripts'
# own defaults ARE the profile. Setting a key is only legal when it equals the value below.
#
# enforce: required = must resolve to this value (explicit env / env file)
#          if-set   = unset is fine (script/launcher default is right); a different explicit value FAILS
#          advisory = a different value only WARNS
# compare: max = actual <= value passes (equal) / warns (tighter), greater FAILS (a loosened threshold); min = the reverse
#
# @profile: class-a-ci-guardrails
# @class: a
# @purpose: Cheap regression tripwires (CI guardrails), engine/runtime micro-benchmarks and the non-DB stress sanity. NOT capacity numbers; hardware is a GitHub ubuntu runner, thresholds are deliberately loose.
# @command: make bench-matching-engine-check bench-platform-runtime-check   (CI runs scripts/ci/check-matching-bench.sh and scripts/ci/check-runtime-bench.sh directly)
# @command: make bench-matching-engine            (raw micro-benchmarks, no thresholds)
# @command: JS_RUNTIME=node make dev-stress-runtime-nodb   (stress sanity at 1000/2500 rps; compose-based; needs Docker)
# @compose: none for the guardrails; stress sanity uses compose.base.yml + compose.local.yml (REEF_COMPOSE_FILES), no compose profiles
# @pass: check-matching-bench.sh: ns/op and allocs/op of the LAST line of each of 3 benchmarks <= limits below, and every bench line present. check-runtime-bench.sh: OrderApplicationServicePerfGuardrailTest nsPerOp <= budget. Stress sanity: success rate >= 95% (no-DB) at 1000 and 2500 rps.
# @tools: go (>= version in services/matching-engine/go.mod), java + gradle wrapper (JDK 21 in CI) for the runtime guardrail
# @claimable: no  (a green guardrail proves no performance; see CONFLICTS)
#
# CONFLICTS (recorded, value chosen = what the CI scripts actually use):
# - LIMIT_MODIFY_NS 300000 is ~300x above the measured 807-939 ns/op (HFT audit 2026-07-11) and
#   REEF_RUNTIME_SUBMIT_NS_PER_OP_BUDGET 20 ms is orders above real cost: these are crash tripwires,
#   not regression detectors. Owner rule: CI thresholds are NOT changed in this lane.
# - docs/PERFORMANCE_LEARNINGS.md still lists BenchmarkModifyOrder 109443 ns/op (annotated stale).
# - Raw scripts/dev/stress.mjs defaults (workers 12, schedule drop) differ from the CI stress profile
#   (workers 256, precise). Always go through `reef-dev.mjs stress run <profile>` (make dev-stress-*).

# why: Parallel/multi-instrument benches are intentionally outside the guardrail; widening the regex only checks the 3 named lines.
# default: BenchmarkSubmitOrderResting|BenchmarkSubmitOrderMatchAgainstResting|BenchmarkModifyOrder (scripts/ci/check-matching-bench.sh:6)
# enforce: if-set
BENCH_REGEX="BenchmarkSubmitOrderResting|BenchmarkSubmitOrderMatchAgainstResting|BenchmarkModifyOrder"

# why: CI threshold. Must not be loosened to make a run pass; a loosened local value makes local green != CI green.
# default: 5000 (check-matching-bench.sh:8)
# enforce: if-set
# compare: max
LIMIT_SUBMIT_NS=5000

# why: CI threshold (allocs/op), same reason.
# default: 24 (check-matching-bench.sh:9)
# enforce: if-set
# compare: max
LIMIT_SUBMIT_ALLOCS=24

# why: CI threshold for match-against-resting.
# default: 10000 (check-matching-bench.sh:10)
# enforce: if-set
# compare: max
LIMIT_MATCH_NS=10000

# why: CI threshold (allocs/op).
# default: 48 (check-matching-bench.sh:11)
# enforce: if-set
# compare: max
LIMIT_MATCH_ALLOCS=48

# why: CI threshold for modify. Very loose (see CONFLICTS) - a tripwire only.
# default: 300000 (check-matching-bench.sh:12)
# enforce: if-set
# compare: max
LIMIT_MODIFY_NS=300000

# why: CI threshold (allocs/op).
# default: 16 (check-matching-bench.sh:13)
# enforce: if-set
# compare: max
LIMIT_MODIFY_ALLOCS=16

# why: Iteration count of the Gradle perf guardrail test; fewer iterations = noisier ns/op.
# default: 1500 (scripts/ci/check-runtime-bench.sh:8)
# enforce: if-set
# compare: min
REEF_RUNTIME_PERF_ITERATIONS=1500

# why: CI budget (20 ms/op) for the in-memory submit path; catastrophic-regression tripwire only.
# default: 20000000 (check-runtime-bench.sh:9)
# enforce: if-set
# compare: max
REEF_RUNTIME_SUBMIT_NS_PER_OP_BUDGET=20000000

# why: Stress sanity must use the precise scheduler; `drop` (raw stress.mjs default) silently sheds scheduled work so offered load < target.
# default: drop in raw scripts/dev/stress.mjs; precise via the CI profile wrappers (.github/workflows/throughput-stress.yml)
# enforce: advisory
DEV_STRESS_RATE_SCHEDULE=precise

# why: CI sanity rates; this is sanity at 1000/2500 rps, not capacity.
# default: raw stress.mjs default differs; CI sets it (throughput-stress.yml)
# enforce: advisory
DEV_STRESS_RATES=1000,2500

# why: CI no-DB sweep workers (256); raw stress.mjs default 12 makes the load generator the limit.
# default: 12 (scripts/dev/stress.mjs:34); CI nodb job sets 256
# enforce: advisory
DEV_STRESS_SWEEP_WORKERS=256

# why: CI no-DB minimum success rate guardrail.
# default: 90 (stress.mjs); CI nodb job sets 95
# enforce: advisory
DEV_STRESS_MIN_SUCCESS_RATE_PCT=95
