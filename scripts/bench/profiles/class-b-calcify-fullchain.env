# Reef benchmark profile - CLASS B: Calcify full chain
#
# Machine-readable: KEY=value lines, each preceded by `# why:`, `# default:`, `# enforce:`.
# Two key families:
#   FC_*                  knobs of scripts/dev/calcify-fullchain-soak.mjs, read from the environment
#   <service>.<ENV_VAR>   settings of the compose overlay that scripts/dev/calcify-direct-bootstrap.mjs
#                         generates (setup/compose-profile.json). They live ONLY in that overlay, not in
#                         any tracked compose file or .env, so they are verified (a) statically against
#                         the bootstrap source at preflight time and (b) against the real overlay with
#                         `preflight.mjs --class b --overlay <out>/setup/compose-profile.json`.
# This file is NOT meant to be sourced (dotted overlay keys); the FC_* values are the soak's own defaults.
# REEF_TOPIC_* keys are broker topic configs (write.caching, max.message.bytes), checked with rpk when a broker is up.
#
# enforce: required = must resolve to this value explicitly
#          if-set   = unset is fine (the soak default is right); a different explicit value is a FAIL
#          advisory = a different value only WARNS
#
# @profile: class-b-calcify-fullchain
# @class: b
# @purpose: The ONE supported full-chain path (PR 579): paced trades through Netty intake -> durable Redpanda -> 16 Go matching lanes -> Phase 1 extractor/verifier -> Phase 2 managed resolver -> capacity finance lanes -> projection into Postgres, asserting the exact decision count. No throughput/latency threshold: "no capacity claim follows from a run by itself".
# @command: make calcify-fullchain-soak FC_RATE=1000 FC_SECONDS=60
# @command: (PAID, owner approves size and cost first) REEF_DO_SIZE=g5-16vcpu-64gb-50gb REEF_DO_REGION=atl1 make calcify-droplet-run MATRIX=fullchainsmoke
# @compose: -f compose.base.yml -f compose.local.yml -f compose.calcify.yml -f <out>/setup/compose-profile.json ; COMPOSE_PROFILES=redpanda,calcify-phase1,calcify-phase2 ; unique COMPOSE_PROJECT_NAME=reef-calcify-fc-<id>. Not compose.arena.yml; compose.fullchain-tmpfs.yml is orphaned (no script references it).
# @pass: result integrity == "ok": projected decisions EXACTLY trades*perTrade + (lanes*2 + instruments), droppedPairs == 0, acceptedOrders == completedTrades. Nothing else is asserted.
# @host: local = Docker VM >= 10 CPU / 15.6 GiB, quiet host, no other Reef stack (fixed container names reef-boundary-postgres, host ports 8080/8081). Dedicated host: tracked tree must be clean (git archive HEAD).
# @claimable: no (laptop numbers are never a claim; full-chain 10k/15min on one host is NOT established)
#
# CONFLICTS (recorded; value in this file = what the soak/bootstrap actually use):
# - Lane/partition count: docs/work/CALCIFY_CAPACITY_RUNTIME.md still says four lanes and a withdrawn 2.9k trades/s
#   Postgres-intake wall; scripts are 16 lanes / 16 partitions / in-memory Netty intake. 16 chosen.
# - Terminal retention: bootstrap default 250000 per book; the soak overrides to 3906 (FC_TERMINAL_PER_BOOK),
#   narrowing the lookup horizon. 3906 chosen (soak is the supported entry). Class C uses 250000.
# - Publish-pipeline queue: bootstrap/soak 8192; stream-direct-nodb profile 1024; compose default 4096. 8192 chosen.
# - Load workers: soak FC_WORKERS 1024 (chosen); calcify-load default 256.
# - FC_INSTRUMENTS appears in CAPACITY_RUNTIME.md but the soak never reads it (64 instruments, fixed by bootstrap).
# - compose.fullchain-tmpfs.yml is documented as the FC_TMPFS mechanism but is unused; the soak creates tmpfs volumes itself.
# - Redpanda: compose.local.yml v26.2.4 is what the soak runs (chosen); droplet engine-drain cases and the ledger say v26.2.3.
# - Compression: validated engine profile pins MATCHING_ENGINE_KAFKA_COMPRESSION_TYPE=none; the lz4 credited in docs (#571) is the capacity Streams producer.
# - Droplet default size is c-16 (Xeon 8168) while finance-lane docs recommend AMD EPYC g5-16vcpu-64gb-50gb. Preflight cannot determine the right size; owner decides.
# - Default Compose project of the bootstrap run alone is a fixed 2026-10-02 string and its default images are the stale tag calcify-10k-master461; the soak overrides both. Never run the bootstrap directly.

# why: capture-settle-v1 = one decision per trade. two-step = 2 decisions/trade, which changes the expected exact decision count and is not comparable.
# default: capture-settle-v1
# enforce: if-set
FC_MODE=capture-settle-v1

# why: false keeps every settled trade on the heap (~1.2-1.5 KB/trade; 10M trades ~10 GB).
# default: true
# enforce: if-set
FC_EVICT=true

# why: int64 cash: at the load price large quantities overflow ("does not fit int64"). 1 lasts 9e18/1.5e11 trades.
# default: 1
# enforce: if-set
FC_QUANTITY=1

# why: Fewer load workers make the generator the limit.
# default: 1024 (calcify-load default is 256)
# enforce: advisory
FC_WORKERS=1024

# why: true reuses images already built = silently benchmarks stale code after any change.
# default: false
# enforce: if-set
FC_SKIP_BUILD=false

# why: tmpfs volumes are NOT durable and count against RAM (24+40+6 GB defaults); no durability/recovery claim is possible from such a run.
# default: false
# enforce: if-set
FC_TMPFS=false

# why: false leaves the compose project and tmpfs volumes behind; the next run collides on fixed names.
# default: true
# enforce: if-set
FC_TEARDOWN=true

# why: The bootstrap's own 500 batch is the validated engine batch; raising it also needs raised message limits.
# default: 500 (bootstrap)
# enforce: if-set
FC_ENGINE_BATCH=500

# why: Soak retention regime (see CONFLICTS); changes lookup horizon and requires fresh state.
# default: 3906
# enforce: if-set
FC_TERMINAL_PER_BOOK=3906

# why: Capacity JVM heap; tight on a 15.6 GiB Docker VM alongside Redpanda, 3 Postgres and the Java sidecars.
# default: -Xmx8g -XX:+UseParallelGC
# enforce: advisory
FC_CAPACITY_JAVA_OPTS="-Xmx8g -XX:+UseParallelGC"

# why: A stale pinned tag means old code is benchmarked silently (compose is invoked without --build). The soak sets both images itself; this must never point at the pinned tag.
# default: reef-platform-runtime:calcify-10k-master461 (calcify-direct-bootstrap.mjs image default)
# enforce: if-set
CALCIFY_DIRECT_IMAGE=reef-platform-runtime

# why: Same stale-tag trap for the matching engine.
# default: reef-matching-engine:calcify-10k-master461 (bootstrap)
# enforce: if-set
CALCIFY_DIRECT_MATCHING_IMAGE=reef-matching-engine

# why: JDK HttpServer tops out ~6k/s.
# default: jdk (compose.base.yml:171)
# enforce: required
platform-api.PLATFORM_HTTP_SERVER=netty

# why: Calcify path is Kafka-compatible only.
# default: jetstream (compose.base.yml:73)
# enforce: required
platform-api.STREAM_ACK_LOG_PROVIDER=redpanda

# why: Engine consumes the same Kafka-compatible log.
# default: jetstream (compose.base.yml:251)
# enforce: required
matching-engine.STREAM_ACK_LOG_PROVIDER=redpanda

# why: Postgres intake caps ACK at ~6-8k/s and was the withdrawn "2.9k wall".
# default: postgres (compose.base.yml:89)
# enforce: required
platform-api.STREAM_ACK_INTAKE_STORE=inmemory

# why: SQL idempotency on the hot path.
# default: postgres (compose.base.yml:24)
# enforce: required
platform-api.EXTERNAL_API_IDEMPOTENCY_STORE=inmemory

# why: Synchronous DB on submit path.
# default: postgres (compose.base.yml:16)
# enforce: required
platform-api.RUNTIME_PERSISTENCE=noop

# why: Unbounded intake retention grows the heap.
# default: 0 = unlimited (compose.base.yml:90)
# enforce: required
platform-api.STREAM_ACK_INMEMORY_INTAKE_MAX_ENTRIES=100000

# why: Intake lock contention.
# default: 64 (compose.base.yml:91)
# enforce: required
platform-api.STREAM_ACK_INMEMORY_INTAKE_SHARDS=256

# why: 16 lanes = 16 partitions; the capacity plan refuses topics with partitions != lanes.
# default: 64 (compose.base.yml:88)
# enforce: required
platform-api.STREAM_ACK_PARTITION_COUNT=16

# why: Engine and API must agree on the partition count.
# default: 64 (compose.base.yml:261)
# enforce: required
matching-engine.STREAM_ACK_PARTITION_COUNT=16

# why: No publish pipeline = per-request synchronous publish, no partition lanes.
# default: false (compose.base.yml:95)
# enforce: required
platform-api.STREAM_ACK_PUBLISH_PIPELINE_ENABLED=true

# why: Validated lane queue (see CONFLICTS).
# default: 4096 (compose.base.yml:96)
# enforce: required
platform-api.STREAM_ACK_PUBLISH_PIPELINE_QUEUE_CAPACITY=8192

# why: Command-log writes on the hot path.
# default: disabled (compose.base.yml:54)
# enforce: required
platform-api.EXTERNAL_API_COMMAND_LOG_MODE=disabled

# why: Legacy capture writes on the hot path.
# default: postgres (compose.base.yml:53)
# enforce: required
platform-api.EXTERNAL_API_COMMAND_CAPTURE_MODE=disabled

# why: Competing JetStream workers.
# default: true in stream-ack profile
# enforce: required
platform-api.STREAM_ACK_WORKER_ENABLED=false

# why: Engine consumes nothing otherwise.
# default: false (compose.base.yml:235)
# enforce: required
matching-engine.MATCHING_ENGINE_DIRECT_STREAM_ENABLED=true

# why: All 16 partitions must be consumed.
# default: empty (compose.base.yml:237)
# enforce: required
matching-engine.MATCHING_ENGINE_DIRECT_STREAM_PARTITIONS=0..15

# why: Validated engine batch.
# default: 500 (compose.base.yml:239)
# enforce: required
matching-engine.MATCHING_ENGINE_DIRECT_STREAM_BATCH_SIZE=500

# why: 1 MiB producer cap rejects event batches; the bootstrap pairs this with a topic max.message.bytes=4194304 alter-config on the EVENTS topic.
# default: 1048576 (compose.base.yml:257)
# enforce: required
matching-engine.MATCHING_ENGINE_KAFKA_MAX_MESSAGE_BYTES=4194304

# why: Validated engine codec (see CONFLICTS).
# default: empty -> lz4 via STREAM_ACK_KAFKA_COMPRESSION_TYPE (compose.base.yml:258)
# enforce: required
matching-engine.MATCHING_ENGINE_KAFKA_COMPRESSION_TYPE=none

# why: Compose default of 100 starves the verifier at 10k/s.
# default: 100 (compose.calcify.yml:38)
# enforce: required
calcify-verifier.CALCIFY_VERIFIER_MAX_POLL_RECORDS=1000

# why: Validated resolver threads; compose default 1.
# default: 1 (compose.calcify.yml:60)
# enforce: required
calcify-resolver.CALCIFY_RESOLVER_THREADS=2

# why: Standbys double the state writes; the validated profile runs none.
# default: 1 (compose.calcify.yml:58)
# enforce: required
calcify-resolver.CALCIFY_RESOLVER_STANDBYS=0

# why: Validated pending window; compose default 200.
# default: 200 (compose.calcify.yml:61)
# enforce: required
calcify-resolver.CALCIFY_RESOLVER_MAX_PENDING=1000

# why: Durability of topics as ACTUALLY created (verified with rpk topic describe -c when a broker is reachable).
# default: broker default write.caching (cache ON)
# enforce: required
REEF_TOPIC_WRITE_CACHING=false

# why: EVENTS topic cap must match the 4 MiB producer cap.
# default: broker default 1048576
# enforce: required
REEF_TOPIC_MAX_MESSAGE_BYTES=4194304
