name: reef-calcify-financial-s1-85f0ce8c
services:
  rp0:
    cpus: 1
    command:
      - redpanda
      - start
      - --overprovisioned
      - --smp
      - "1"
      - --memory
      - 1G
      - --reserve-memory
      - 0M
      - --check=false
      - --node-id
      - "0"
      - --kafka-addr
      - internal://0.0.0.0:9092,external://0.0.0.0:39192
      - --advertise-kafka-addr
      - internal://rp0:9092,external://127.0.0.1:39192
      - --rpc-addr
      - 0.0.0.0:33145
      - --advertise-rpc-addr
      - rp0:33145
      - --seeds
      - rp0:33145
    healthcheck:
      test:
        - CMD
        - rpk
        - cluster
        - info
        - -X
        - brokers=127.0.0.1:9092
      timeout: 2s
      interval: 3s
      retries: 30
    image: redpandadata/redpanda:v26.2.3
    labels:
      reef.test: calcify-financial-sprint1
    mem_limit: "2147483648"
    networks:
      default: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 39192
        published: "39192"
        protocol: tcp
    volumes:
      - type: volume
        source: rp0-data
        target: /var/lib/redpanda/data
        volume: {}
  rp1:
    cpus: 1
    command:
      - redpanda
      - start
      - --overprovisioned
      - --smp
      - "1"
      - --memory
      - 1G
      - --reserve-memory
      - 0M
      - --check=false
      - --node-id
      - "1"
      - --kafka-addr
      - internal://0.0.0.0:9092,external://0.0.0.0:39292
      - --advertise-kafka-addr
      - internal://rp1:9092,external://127.0.0.1:39292
      - --rpc-addr
      - 0.0.0.0:33145
      - --advertise-rpc-addr
      - rp1:33145
      - --seeds
      - rp0:33145
    healthcheck:
      test:
        - CMD
        - rpk
        - cluster
        - info
        - -X
        - brokers=127.0.0.1:9092
      timeout: 2s
      interval: 3s
      retries: 30
    image: redpandadata/redpanda:v26.2.3
    labels:
      reef.test: calcify-financial-sprint1
    mem_limit: "2147483648"
    networks:
      default: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 39292
        published: "39292"
        protocol: tcp
    volumes:
      - type: volume
        source: rp1-data
        target: /var/lib/redpanda/data
        volume: {}
  rp2:
    cpus: 1
    command:
      - redpanda
      - start
      - --overprovisioned
      - --smp
      - "1"
      - --memory
      - 1G
      - --reserve-memory
      - 0M
      - --check=false
      - --node-id
      - "2"
      - --kafka-addr
      - internal://0.0.0.0:9092,external://0.0.0.0:39392
      - --advertise-kafka-addr
      - internal://rp2:9092,external://127.0.0.1:39392
      - --rpc-addr
      - 0.0.0.0:33145
      - --advertise-rpc-addr
      - rp2:33145
      - --seeds
      - rp0:33145
    healthcheck:
      test:
        - CMD
        - rpk
        - cluster
        - info
        - -X
        - brokers=127.0.0.1:9092
      timeout: 2s
      interval: 3s
      retries: 30
    image: redpandadata/redpanda:v26.2.3
    labels:
      reef.test: calcify-financial-sprint1
    mem_limit: "2147483648"
    networks:
      default: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 39392
        published: "39392"
        protocol: tcp
    volumes:
      - type: volume
        source: rp2-data
        target: /var/lib/redpanda/data
        volume: {}
networks:
  default:
    name: reef-calcify-financial-s1-85f0ce8c_default
volumes:
  rp0-data:
    name: reef-calcify-financial-s1-85f0ce8c_rp0-data
    labels:
      reef.test: calcify-financial-sprint1
  rp1-data:
    name: reef-calcify-financial-s1-85f0ce8c_rp1-data
    labels:
      reef.test: calcify-financial-sprint1
  rp2-data:
    name: reef-calcify-financial-s1-85f0ce8c_rp2-data
    labels:
      reef.test: calcify-financial-sprint1
x-broker:
  cpus: 1
  healthcheck:
    interval: 3s
    retries: 30
    test:
      - CMD
      - rpk
      - cluster
      - info
      - -X
      - brokers=127.0.0.1:9092
    timeout: 2s
  image: redpandadata/redpanda:v26.2.3
  labels:
    reef.test: calcify-financial-sprint1
  mem_limit: 2g
